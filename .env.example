# ─── Serveur web ───────────────────────────────────────────────
# 127.0.0.1 = accessible uniquement depuis ce poste (recommandé).
HOST=127.0.0.1
PORT=3000
# true uniquement derrière HTTPS (cookie "Secure").
SECURE_COOKIES=false
DEFAULT_LANG=fr

# ─── Accès au back-office ──────────────────────────────────────
# Les comptes vivent en base (data/lkm-bo.db). Les deux variables ci-dessous ne servent
# qu'au PREMIER démarrage, pour créer l'administrateur initial : sans elles, un mot de
# passe aléatoire est généré et affiché une fois dans la console.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
# 32+ caractères aléatoires (npm run set-password en génère un si vide).
SESSION_SECRET=
# Emplacement de la base (comptes, rôles, permissions, sessions).
DB_FILE=data/lkm-bo.db

# ─── Politique de connexion ────────────────────────────────────
PASSWORD_MIN_LENGTH=12
# Verrouillage temporaire du compte après N échecs.
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCK_MINUTES=15
# Tentatives de connexion acceptées par IP et par quart d'heure.
LOGIN_RATE_LIMIT=20

# ─── Identifiants SSH (référencés par config/servers.json) ─────
# Clé privée du compte "tech" (port 2279).
SSH_KEY_PATH=D:/ssh/tech-tsarajoro
# Passphrase de la clé, si elle en a une.
SSH_KEY_PASSPHRASE=
# Clé du compte "lockop" (port 2278) — identique par défaut, à ajuster si besoin.
LOCKOP_KEY_PATH=D:/ssh/tech-tsarajoro
LOCKOP_KEY_PASSPHRASE=
# Exemple d'authentification par mot de passe (auth.type = "password") :
# VPS_EXEMPLE_PASSWORD=

# ─── Réglages SSH ──────────────────────────────────────────────
SSH_READY_TIMEOUT_MS=15000
SSH_COMMAND_TIMEOUT_MS=60000
# Fermeture auto d'une connexion inactive (0 = jamais).
SSH_IDLE_TIMEOUT_MS=900000
SSH_MAX_PARALLEL=4
# true = refuse tout hôte absent de config/known_hosts.json (sinon : confiance au 1er contact).
SSH_STRICT_HOST_KEY=false

# Durée de cache de la liste des domaines (ms).
DOMAIN_CACHE_TTL_MS=120000

# ─── Traduction automatique (écran Actions) ────────────────────
# Facultatif : le PREMIER service renseigné est utilisé. Sans aucun, l'écran
# fonctionne quand même — le dictionnaire du parc propose les expressions
# courantes, l'agent saisit le reste lui-même.
#
# Volume mesuré sur le parc le 23/09/2026 : environ 61 000 caractères pour les
# 28 176 domaines. L'offre gratuite de DeepL (500 000 caractères par mois) suffit
# donc largement ; une clé « :fx » désigne cette offre.
#
# DeepL — https://www.deepl.com/pro-api (meilleure qualité sur les langues du parc)
# DEEPL_KEY=

# Google Cloud Translation v2 — clé d'API d'un projet Google Cloud, facturé au caractère.
# GOOGLE_TRANSLATE_KEY=

# LibreTranslate — libre, installable sur vos serveurs : aucun texte ne sort du parc.
# LIBRETRANSLATE_URL=https://libretranslate.exemple.net
# LIBRETRANSLATE_KEY=

# ─── Gestionnaire de fichiers ──────────────────────────────────
# Entrées affichées au maximum par dossier.
FILES_MAX_ENTRIES=2000
# Taille maximale d'un fichier ouvert dans l'éditeur (2 Mio).
FILES_MAX_EDIT_BYTES=2097152
# Taille maximale traitée lors d'une compression / décompression (200 Mio).
FILES_MAX_ARCHIVE_BYTES=209715200
FILES_MAX_ARCHIVE_ENTRIES=20000
# Nombre d'éléments maximum par opération groupée.
FILES_MAX_BATCH=200
# Taille maximale d'un fichier téléversé depuis le poste (200 Mio).
FILES_MAX_UPLOAD_BYTES=209715200
